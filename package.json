{
  "name": "claudian-voice",
  "version": "0.2.1",
  "description": "Voice conversation companion plugin for Claudian (Obsidian).",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "claudian",
    "voice"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "esbuild": "^0.28.1",
    "obsidian": "1.13.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  }
}
